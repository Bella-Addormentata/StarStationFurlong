# The GitHub machine's part in the hole-punch test (probe branch, never to merge).
# A push to claude/hole-punch-probe starts one run with these values.

# ROLE=guest: the owner's computer holds a room, this machine knocks and joins.
# ROLE=host:  this machine holds a room, the owner's computer knocks and joins.
ROLE=host
# Minutes the page stays in the room once it has the invite.
MINUTES=30
# Minutes a guest waits for its sealed invite on the io branch.
WAIT_MINUTES=60
# KNOCK=off is the control run: SSF_DHT_KNOCK=0 on this machine.
KNOCK=on
# ROLE=host only: the guest's RSA public key, the PEM file in base64 on one line.
GUEST_
